---
// Public WCOPA Contestant Directory embed page.
// Route: /contestants/{year}
//
// Embeds the interactive contestant directory hosted on
// portal.wcopa.com (Next.js) inside an iframe on the wcopa.com
// marketing site. The directory pulls contestant data live from
// portal.wcopa.com's public JSON API, so this page never needs to
// be republished when contestant profiles change.
//
// To add a new year (e.g. 2027), append it to KNOWN_YEARS below.
// Old years (2024) archive automatically — the same iframe just
// points at that year's data.
import BaseLayout from "@/layouts/BaseLayout.astro";

const KNOWN_YEARS = ["2024", "2026"];

export async function getStaticPaths() {
  return ["2024", "2026"].map((year) => ({
    params: { year },
  }));
}

const { year } = Astro.params;
if (!KNOWN_YEARS.includes(year ?? "")) return Astro.redirect("/404");

const embedUrl =
  `https://portal.wcopa.com/directory/${year}/browse` +
  `?utm_source=wcopa.com&utm_medium=embed&utm_campaign=directory-${year}`;

const title = `${year} Contestant Directory | WCOPA`;
const description = `Browse the official WCOPA ${year} contestant directory — biographies, photos, events, and representation for every published contestant.`;
---

<BaseLayout title={title} description={description}>
  <section class="bg-dark-1 text-white">
    <div class="container mx-auto px-4 md:px-0 py-16 md:py-20">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="text-yellow uppercase tracking-widest text-xs md:text-sm font-semibold mb-4"
        >
          Directory · {year}
        </p>
        <h1 class="text-4xl md:text-6xl font-bold mb-4 md:mb-6">
          Contestant Directory
        </h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mx-auto">
          Explore every published contestant competing at WCOPA {year} — search
          by name or country, filter by discipline, and view individual profiles
          with photos, events, and representation.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container mx-auto px-4 md:px-6 py-8 md:py-12">
      <div
        class="rounded-2xl overflow-hidden shadow-[0_6px_28px_rgba(0,0,0,0.08)] border border-black/5 bg-white"
      >
        <iframe
          id="wcopa-directory-frame"
          src={embedUrl}
          title={`WCOPA ${year} Contestant Directory`}
          loading="lazy"
          allow="fullscreen; clipboard-write; web-share"
          class="w-full block border-0"
          style="height: 1200px;"
          scrolling="no"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // The portal (portal.wcopa.com/directory/{year}/browse) posts its
  // current content height whenever the layout changes (filter, resize,
  // image load). We resize the iframe to match so the whole grid fits
  // without an inner scrollbar — visitors just scroll the outer page.
  (function () {
    const frame = document.getElementById("wcopa-directory-frame");
    if (!frame) return;
    const ALLOWED_ORIGIN = "https://portal.wcopa.com";
    // Wheel-forward fallback. Some browsers (WebKit/Safari in
    // particular) never chain wheel events from a cross-origin iframe
    // to the parent page, even when the iframe document itself cannot
    // scroll — the embed feels "scroll-dead" anywhere over the frame.
    // The portal page posts its wheel deltas up; we apply them ONLY
    // when native scrolling isn't already happening (tracked via the
    // scroll listener below), so browsers that DO chain don't scroll
    // at double speed.
    let lastNativeScroll = 0;
    window.addEventListener("scroll", function () { lastNativeScroll = Date.now(); }, { passive: true });
    window.addEventListener("message", function (event) {
      if (event.origin !== ALLOWED_ORIGIN) return;
      const data = event.data;
      if (data && data.type === "wcopa-directory-wheel") {
        if (Date.now() - lastNativeScroll > 150) {
          // behavior:'instant' sidesteps html{scroll-behavior:smooth},
          // which would queue an animation per wheel tick and stutter.
          window.scrollBy({ top: Number(data.deltaY) || 0, behavior: "instant" });
        }
        return;
      }
      if (!data || data.type !== "wcopa-directory-height") return;
      // Ceiling is a sanity guard against a runaway postMessage, not a
      // layout constraint. It was 20000px — fine at 172 published
      // contestants, but the 2026 directory now has 359 (~34000px), so
      // the clamp froze the frame mid-list: the iframe doc became
      // internally scrollable, scrolling="no" swallowed every wheel
      // event over it, and the bottom 14000px of contestants were
      // unreachable. 100000px covers any realistic roster.
      const h = Math.max(600, Math.min(100000, Number(data.height) || 0));
      if (h && Math.abs(frame.clientHeight - h) > 4) {
        frame.style.height = h + "px";
      }
    });
  })();
</script>
